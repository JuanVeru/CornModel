# Database configuration
# When running inside Docker Compose, we connect to the 'db' container
DATABASE_URL=postgresql://postgres:postgres@db:5432/corn_db

# Security
JWT_SECRET=corn_model_jwt_secret_key_2026_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Admin Seeding
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword
